# Copy to .env (never commit .env). All values optional; the demo runs offline without them.
FERMENTAI_API_TOKEN=change-me-local-device-token      # operator token (dashboard/agents/simulators); devices fall back to it
FERMENTAI_DEVICE_TOKEN_A=                             # optional per-device token: ESP32 A, chamber A device endpoints only
FERMENTAI_DEVICE_TOKEN_B=                             # optional per-device token: ESP32 B, chamber B device endpoints only
FERMENTAI_HOST=0.0.0.0
FERMENTAI_PORT=8000
FERMENTAI_DB_PATH=data/fermentai.sqlite3
FERMENTAI_LLM_MODE=offline                            # offline | claude_cli | anthropic_api
ANTHROPIC_API_KEY=                                    # only for anthropic_api mode; billed separately
BREV_INSTANCE=fermentai-gpu
