+void TemperatureController::reset() {
+  state_ = Direction::None;
+  if (pid_) pid_->reset();
+}
+
+ControlDemand TemperatureController::compute(float temp_c, float setpoint_c, uint32_t now_ms) {
+  if (!pid_) return compute(temp_c, setpoint_c);
+  const ControlSel sel = pid_->selected();
+  if (sel == ControlSel::Pid) {
+    if (prev_sel_ != (uint8_t)ControlSel::Pid) {  // bumpless hand-over from prop/hyst
+      pid_->engage(last_.dir == Direction::Heat ? last_.fraction
+                   : last_.dir == Direction::Cool ? -last_.fraction : 0.0f);
+      prev_sel_ = (uint8_t)ControlSel::Pid;
+    }
+    last_ = pid_->compute(temp_c, setpoint_c, now_ms);  // signed demand -> dir + fraction
+    state_ = last_.dir;
+    return last_;
+  }
+  if (prev_sel_ == (uint8_t)ControlSel::Pid) state_ = Direction::None;  // restart hysteresis gate
+  prev_sel_ = (uint8_t)sel;
+  if (sel == ControlSel::Hysteresis) {
+    cfg_.mode = Mode::Hysteresis;
+  } else {
+    cfg_.mode = Mode::Proportional;
+    cfg_.kp_per_c = pid_->gains().kp;
+  }
+  last_ = compute(temp_c, setpoint_c);
+  return last_;
+}
+
 }  // namespace fa
