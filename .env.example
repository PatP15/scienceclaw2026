# Copy to .env (never commit .env). All values optional; the demo runs offline without them.
FERMENTAI_API_TOKEN=change-me-local-device-token      # shared bearer token for ESP32 -> API
FERMENTAI_HOST=0.0.0.0
FERMENTAI_PORT=8000
FERMENTAI_DB_PATH=data/fermentai.sqlite3
FERMENTAI_LLM_MODE=offline                            # offline | claude_cli | anthropic_api
ANTHROPIC_API_KEY=                                    # only for anthropic_api mode; billed separately
BREV_INSTANCE=fermentai-gpu
